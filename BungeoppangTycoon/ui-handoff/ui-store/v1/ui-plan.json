    {"id": "bean-coin-chip", "role": "팥코인 표시", "implementation": "hybrid", "states": ["default"], "dynamicContent": true, "asset": "button-paper.png", "nineSlice": null, "anchorIntent": "top-right", "minHitSize": null},
