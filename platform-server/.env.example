# Server
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
GAME_ORIGIN=http://localhost:3000
GAME_BUILD_DIR=../BungeoppangTycoon/Builds/WebGL
SESSION_TTL_SECONDS=3600
APP_REVISION=local

# Hive Web Login: mock | sandbox | production
HIVE_MODE=mock
HIVE_APP_ID=
HIVE_CLIENT_ID=
HIVE_CLIENT_SECRET=
HIVE_BILLING_APP_ID=
HIVE_BILLING_AUTH_KEY=
HIVE_REDIRECT_URI=http://localhost:3000/hive/cb
HIVE_COUNTRY=KR
HIVE_LANGUAGE=ko
HIVE_WEB_SHOP_URL=

# Market: mock | nicepay-test | hive-web-shop
STORE_MODE=mock
# Catalog: static | hive. HIVE mode loads registered Market PIDs server-side.
STORE_CATALOG_SOURCE=static
STORE_CATALOG_CACHE_SECONDS=300
# Defaults to PUBLIC_BASE_URL/store-products (CloudFront-backed S3 in AWS).
STORE_PRODUCT_IMAGE_BASE_URL=
# Development-only external test panel and grant endpoint.
STORE_DEV_TOOLS=true
NICEPAY_CLIENT_ID=
NICEPAY_SECRET_KEY=
# Optional independent HMAC key for opaque purchase-history cursors.
# NICEPAY_SECRET_KEY or HIVE_BILLING_AUTH_KEY is used when omitted.
PURCHASE_CURSOR_SECRET=
# Persistence: memory | dynamodb
DATA_STORE=memory
DYNAMODB_TABLE=

# OpenAI: mock | live
OPENAI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
