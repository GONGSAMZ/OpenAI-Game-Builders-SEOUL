HIVE_CLIENT_ID=
HIVE_CLIENT_SECRET=
HIVE_REDIRECT_URI=http://localhost:3000/api/v1/auth/hive/callback
HIVE_COUNTRY=KR
HIVE_LANGUAGE=ko

# OpenAI: mock | live
OPENAI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
