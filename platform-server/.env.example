# Server
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
GAME_ORIGIN=http://localhost:3000
SESSION_TTL_SECONDS=3600

# Hive Web Login: mock | sandbox | production
HIVE_MODE=mock
